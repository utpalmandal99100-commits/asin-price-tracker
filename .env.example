# Amazon India via the official Amazon Creators API (Associates Central > Tools > Creators API).
# Leave blank to enter Amazon prices manually instead.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# Version shown next to your credentials in Associates Central (e.g. 2.2 or 3.2).
AMAZON_CREDENTIAL_VERSION=2.2
# Your Amazon.in Associates tracking ID, e.g. yourname-21
AMAZON_PARTNER_TAG=

# A manual price check older than this many hours is shown as stale and not used for "Lowest".
MANUAL_PRICE_MAX_AGE_HOURS=24
# Skip API calls for a listing refreshed within this many minutes (Refresh on a single product always re-checks).
MIN_REFRESH_MINUTES=10
